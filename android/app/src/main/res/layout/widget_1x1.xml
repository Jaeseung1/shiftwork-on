<?xml version="1.0" encoding="utf-8"?>
<!-- 교대온 위젯. 디자인 기준: design/pages/widget.html -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_empty" android:textColor="@color/w_sub" android:textSize="12sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="4dp">
        <TextView android:id="@+id/today_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_sub" android:textStyle="bold" />
        <TextView android:id="@+id/today_name" android:layout_width="wrap_content" android:layout_marginTop="3dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="24sp" android:textColor="@color/w_blue" android:textStyle="bold" />
        <TextView android:id="@+id/live" android:layout_width="wrap_content" android:layout_marginTop="3dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_blue" android:textStyle="bold" />
        <TextView android:id="@+id/live_time" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_body" />
    </LinearLayout>
</FrameLayout>
