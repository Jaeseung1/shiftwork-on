<?xml version="1.0" encoding="utf-8"?>
<!-- 교대온 위젯 2x1 (어림 160×80dp). 근무와 상태 칩 · 퇴근/출근 시각 · 내일 한 줄. 크기 시험: WidgetRenderTest. android:text는 위젯 고르는 화면 미리보기(previewLayout)용 예시이고, 실제 글은 WidgetRender가 넣는다.
     한글 글꼴은 줄 높이가 글자 크기의 약 1.5배라(예: 20sp → 약 30dp), 1칸 높이(어림 80dp)에는 글 세 줄까지만 넣는다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_empty" android:textColor="@color/w_sub" android:textSize="11sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/today_name" android:text="일근" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textSize="20sp" android:textColor="@color/w_ink" android:textStyle="bold" />
                <TextView android:id="@+id/live" android:text="근무 중" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/widget_chip_on" android:includeFontPadding="false" android:maxLines="1" android:paddingStart="7dp" android:paddingTop="2dp" android:paddingEnd="7dp" android:paddingBottom="2dp" android:textColor="@color/w_blue" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        <TextView android:id="@+id/live_time" android:text="17:30 퇴근" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_body" />
        <TextView android:id="@+id/next_time" android:text="내일 야근 · 17:30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_sub" />
    </LinearLayout>
</FrameLayout>
