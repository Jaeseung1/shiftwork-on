<?xml version="1.0" encoding="utf-8"?>
<!-- 교대온 위젯 4x1 (어림 340×80dp): 오늘과 내일을 같은 모양으로 나란히(아이콘 칸 · 날짜와 상태 · 근무 이름 · 시각), 가는 선으로만 나눔.
     시안: 사용자가 고른 B안(Stageshow, design/examples/shiftwork-widgets-b). 오늘 근무 이름만 근무 색, 내일은 기본 글자색.
     android:text는 위젯 고르는 화면 미리보기용 예시이고, 실제 글·색·아이콘은 WidgetRender가 넣는다. 크기 시험: WidgetRenderTest -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,ContentDescription"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_empty" android:textColor="@color/w_sub" android:textSize="11sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/today_ico" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/widget_tile_s_day" android:padding="9dp" android:src="@drawable/ic_shift_day" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
                <TextView android:id="@+id/today_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘 · 근무 중" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_sub" android:textStyle="bold" />
                <TextView android:id="@+id/today_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="일근" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="20sp" android:textColor="@color/s_day" android:textStyle="bold" />
                <TextView android:id="@+id/today_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17:30 퇴근" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_body" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="44dp" android:layout_gravity="center_vertical" android:layout_marginStart="8dp" android:layout_marginEnd="12dp" android:background="@color/w_inset" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/next_ico" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/widget_tile_s_night" android:padding="9dp" android:src="@drawable/ic_shift_night" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
                <TextView android:id="@+id/next_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="내일 · 14일 토" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_sub" android:textStyle="bold" />
                <TextView android:id="@+id/next_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="야근" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="20sp" android:textColor="@color/w_ink" android:textStyle="bold" />
                <TextView android:id="@+id/next_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17:30 출근" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_body" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
