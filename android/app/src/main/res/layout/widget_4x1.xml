<?xml version="1.0" encoding="utf-8"?>
<!-- 교대온 위젯 4x1 (어림 340×80dp). 왼쪽 오늘(날짜 · 근무와 상태 칩 · 시간과 남은 시간), 오른쪽 회색 카드에 내일. 크기 시험: WidgetRenderTest. android:text는 위젯 고르는 화면 미리보기(previewLayout)용 예시이고, 실제 글은 WidgetRender가 넣는다.
     한글 글꼴은 줄 높이가 글자 크기의 약 1.5배라(예: 20sp → 약 30dp), 1칸 높이(어림 80dp)에는 글 세 줄까지만 넣는다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_empty" android:textColor="@color/w_sub" android:textSize="11sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="12dp">
            <TextView android:id="@+id/today_cap" android:text="오늘" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_sub" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/today_name" android:text="일근" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textSize="20sp" android:textColor="@color/w_ink" android:textStyle="bold" />
                <TextView android:id="@+id/live" android:text="근무 중" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/widget_chip_on" android:includeFontPadding="false" android:maxLines="1" android:paddingStart="7dp" android:paddingTop="2dp" android:paddingEnd="7dp" android:paddingBottom="2dp" android:textColor="@color/w_blue" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/today_time" android:text="08:30–17:30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_body" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_inset" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/next_cap" android:text="내일" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_sub" android:textStyle="bold" />
            <TextView android:id="@+id/next_name" android:text="야근" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/w_ink" android:textStyle="bold" />
            <TextView android:id="@+id/next_time" android:text="17:30–08:30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_body" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
