<?xml version="1.0" encoding="utf-8"?>
<!-- 교대온 위젯. 디자인 기준: design/pages/widget.html -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_empty" android:textColor="@color/w_sub" android:textSize="12sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/today_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_sub" android:textStyle="bold" />
            <TextView android:id="@+id/today_name" android:layout_width="wrap_content" android:layout_marginTop="3dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="26sp" android:textColor="@color/w_blue" android:textStyle="bold" />
            <TextView android:id="@+id/today_time" android:layout_width="wrap_content" android:layout_marginTop="3dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_body" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="4dp">
            <TextView android:id="@+id/next_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_sub" android:textStyle="bold" />
            <TextView android:id="@+id/next_name" android:layout_width="wrap_content" android:layout_marginTop="3dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="19sp" android:textColor="@color/w_ink" android:textStyle="bold" />
            <TextView android:id="@+id/next_time" android:layout_width="wrap_content" android:layout_marginTop="3dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_body" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.75" android:background="@drawable/widget_inset" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:text="@string/next_5" android:textColor="@color/w_sub" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/app_name" android:textColor="@color/w_sub" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_marginTop="5dp" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/d0_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="9sp" android:textColor="@color/w_sub" />
                    <TextView android:id="@+id/d0_s" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/w_ink" android:textStyle="bold" />
                    <TextView android:id="@+id/d0_n" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/w_body" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/d1_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="9sp" android:textColor="@color/w_sub" />
                    <TextView android:id="@+id/d1_s" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/w_ink" android:textStyle="bold" />
                    <TextView android:id="@+id/d1_n" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/w_body" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/d2_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="9sp" android:textColor="@color/w_sub" />
                    <TextView android:id="@+id/d2_s" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/w_ink" android:textStyle="bold" />
                    <TextView android:id="@+id/d2_n" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/w_body" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/d3_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="9sp" android:textColor="@color/w_sub" />
                    <TextView android:id="@+id/d3_s" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/w_ink" android:textStyle="bold" />
                    <TextView android:id="@+id/d3_n" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/w_body" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/d4_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="9sp" android:textColor="@color/w_sub" />
                    <TextView android:id="@+id/d4_s" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/w_ink" android:textStyle="bold" />
                    <TextView android:id="@+id/d4_n" android:layout_width="wrap_content" android:layout_marginTop="2dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/w_body" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
